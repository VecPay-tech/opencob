# OpenCob Environment Variables
# Copy this file to .env and fill in values for your setup.

# ─── LLM Provider ────────────────────────────────────────────────────────────
# Ollama (default, local inference)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5-coder:7b
OLLAMA_FIM_MODEL=qwen2.5-coder:7b

# ─── OpenAI / Azure OpenAI ────────────────────────────────────────────────────
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1   # Override for Azure: https://<name>.openai.azure.com/openai/deployments/<model>/v1

# ─── Anthropic ────────────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...

# ─── Google Gemini ────────────────────────────────────────────────────────────
# GOOGLE_API_KEY=AIza...

# ─── Privacy ─────────────────────────────────────────────────────────────────
# Set to "true" to enforce air-gapped mode (blocks all outbound LLM calls)
OPENCOB_AIR_GAPPED=false

# ─── MCP ──────────────────────────────────────────────────────────────────────
# Path to MCP server config (JSON array of server definitions)
# OPENCOB_MCP_CONFIG=.opencob/mcp-servers.json

# ─── Development ──────────────────────────────────────────────────────────────
# Log level: debug | info | warn | error
LOG_LEVEL=info

# Node environment
NODE_ENV=development
