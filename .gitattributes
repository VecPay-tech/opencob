# Normalize line endings: LF in repo, auto-convert on checkout
* text=auto

# Source files — always LF
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.mjs  text eol=lf
*.cjs  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.sh   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.css  text eol=lf
*.html text eol=lf

# Binary files — no conversion
*.png  binary
*.jpg  binary
*.ico  binary
*.vsix binary
