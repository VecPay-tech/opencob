{
  "name": "opencob",
  "displayName": "OpenCob",
  "description": "Open-Source AI Coding Assistant — Privacy-First, Legacy-Ready",
  "version": "0.1.1",
  "license": "Apache-2.0",
  "publisher": "opencob",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/mountek/opencob"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Chat"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "chatParticipants": [
      {
        "id": "opencob.chat",
        "fullName": "OpenCob",
        "name": "opencob",
        "description": "Privacy-first AI coding assistant — legacy-ready, agentic workflows, local inference",
        "isSticky": true,
        "commands": [
          {
            "name": "plan",
            "description": "Create a step-by-step plan for a complex task"
          },
          {
            "name": "analyze",
            "description": "Analyze code structure, dependencies, or quality"
          },
          {
            "name": "modernize",
            "description": "Modernize legacy COBOL/RPG/PL-I code"
          },
          {
            "name": "diagram",
            "description": "Generate architecture or flow diagrams"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "OpenCob.openChat",
        "title": "OpenCob: Open Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "OpenCob.switchMode",
        "title": "OpenCob: Switch Mode"
      },
      {
        "command": "OpenCob.newConversation",
        "title": "OpenCob: New Conversation"
      },
      {
        "command": "OpenCob.toggleInlineCompletion",
        "title": "OpenCob: Toggle Inline Completion"
      },
      {
        "command": "OpenCob.selectModel",
        "title": "OpenCob: Select Chat Model"
      },
      {
        "command": "OpenCob.selectCompletionModel",
        "title": "OpenCob: Select Completion Model"
      },
      {
        "command": "OpenCob.selectEmbeddingModel",
        "title": "OpenCob: Select Embedding Model"
      },
      {
        "command": "OpenCob.switchModelTo",
        "title": "OpenCob: Switch Active Model"
      },
      {
        "command": "OpenCob.testConnection",
        "title": "OpenCob: Test Provider Connection"
      },
      {
        "command": "OpenCob.openSettings",
        "title": "OpenCob: Open Settings"
      },
      {
        "command": "OpenCob.undoLastTurn",
        "title": "OpenCob: Undo Last Turn"
      },
      {
        "command": "OpenCob.scanWorkspace",
        "title": "OpenCob: Scan Workspace for Issues"
      },
      {
        "command": "OpenCob.showFindings",
        "title": "OpenCob: Show Findings in Panel"
      },
      {
        "command": "OpenCob.toggleFindingsMode",
        "title": "OpenCob: Toggle Findings View Mode"
      },
      {
        "command": "OpenCob.clearFindings",
        "title": "OpenCob: Clear All Findings"
      },
      {
        "command": "OpenCob.connectEnterprise",
        "title": "OpenCob: Connect to Enterprise Server"
      },
      {
        "command": "OpenCob.disconnectEnterprise",
        "title": "OpenCob: Disconnect from Enterprise Server"
      },
      {
        "command": "OpenCob.generateDiagram",
        "title": "OpenCob: Generate Diagram",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "OpenCob.togglePanel",
        "title": "OpenCob: Toggle Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "OpenCob.inlineEdit",
        "title": "OpenCob: Inline Edit"
      },
      {
        "command": "OpenCob.inlineEditAccept",
        "title": "OpenCob: Accept Inline Edit"
      },
      {
        "command": "OpenCob.inlineEditDiscard",
        "title": "OpenCob: Discard Inline Edit"
      },
      {
        "command": "OpenCob.quickChat",
        "title": "OpenCob: Quick Chat"
      },
      {
        "command": "OpenCob.cycleMode",
        "title": "OpenCob: Cycle Mode"
      },
      {
        "command": "OpenCob.literateCoding",
        "title": "OpenCob: Literate Coding"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "OpenCob.generateDiagram",
          "when": "resourceExtname =~ /\\.(cbl|cob|cobol|cpy|clp|clle|rpg|rpgle|sqlrpgle|bms|dds|pf|lf|dspf|prtf|pli|pl1|obs|mnu|cmd)/",
          "group": "navigation"
        },
        {
          "command": "OpenCob.togglePanel",
          "group": "navigation@100",
          "when": "true"
        }
      ],
      "editor/context": [
        {
          "command": "OpenCob.generateDiagram",
          "when": "resourceExtname =~ /\\.(cbl|cob|cobol|cpy|clp|clle|rpg|rpgle|sqlrpgle|bms|dds|pf|lf|dspf|prtf|pli|pl1|obs|mnu|cmd)/",
          "group": "OpenCob"
        },
        {
          "command": "OpenCob.inlineEdit",
          "when": "editorHasSelection",
          "group": "OpenCob"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "opencob-sidebar",
          "title": "OpenCob",
          "icon": "resources/icon-activitybar.svg"
        }
      ]
    },
    "views": {
      "opencob-sidebar": [
        {
          "type": "webview",
          "id": "OpenCob.chatPanel",
          "name": "Chat",
          "icon": "resources/icon-activitybar.svg"
        },
        {
          "type": "webview",
          "id": "OpenCob.editsPanel",
          "name": "Edits",
          "icon": "resources/icon-activitybar.svg",
          "visibility": "collapsed"
        },
        {
          "type": "webview",
          "id": "OpenCob.activity",
          "name": "Activity & Insights",
          "icon": "resources/icon-activitybar.svg",
          "visibility": "collapsed"
        },
        {
          "type": "tree",
          "id": "OpenCob.findings",
          "name": "Findings",
          "icon": "resources/icon-activitybar.svg",
          "visibility": "collapsed"
        },
        {
          "type": "webview",
          "id": "OpenCob.settingsPanel",
          "name": "Settings",
          "icon": "resources/icon-activitybar.svg",
          "visibility": "collapsed"
        }
      ]
    },
    "keybindings": [
      {
        "command": "OpenCob.togglePanel",
        "key": "ctrl+alt+i",
        "mac": "ctrl+alt+i"
      },
      {
        "command": "OpenCob.inlineEdit",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "editorFocus"
      },
      {
        "command": "OpenCob.quickChat",
        "key": "ctrl+shift+i",
        "mac": "cmd+shift+i"
      },
      {
        "command": "OpenCob.newConversation",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "opencob.chatFocused"
      },
      {
        "command": "OpenCob.cycleMode",
        "key": "ctrl+.",
        "mac": "ctrl+."
      }
    ],
    "configuration": [
      {
        "title": "Provider",
        "order": 1,
        "properties": {
          "OpenCob.connection.test": {
            "type": "null",
            "order": 0,
            "markdownDescription": "### 🔌 Connection\n\n[▶ Test Connection](command:OpenCob.testConnection) — verify provider is reachable and list available models\n\n[⚙ Open Full Settings](command:OpenCob.openSettings)"
          },
          "OpenCob.model.provider": {
            "type": "string",
            "default": "ollama",
            "order": 1,
            "enum": [
              "ollama",
              "litellm",
              "openai",
              "azure",
              "anthropic",
              "gemini",
              "openai-compatible"
            ],
            "enumDescriptions": [
              "Local Ollama server — fully private, no data leaves your machine",
              "LiteLLM proxy — unified gateway to route to any LLM backend",
              "OpenAI API — GPT-4o, GPT-5, o1, o3, etc.",
              "Azure OpenAI Service — enterprise-grade with managed deployment",
              "Anthropic API — Claude Sonnet 4.5, Haiku 4.5, Opus 4",
              "Google Gemini API — Gemini 2.5 Flash and Pro",
              "Any custom OpenAI-compatible endpoint (vLLM, text-gen-webui, etc.)"
            ],
            "markdownDescription": "Which LLM provider to use for inference. Only the settings for the selected provider are relevant.\n\n**Quick start:**\n- Local/private → `ollama`\n- Corporate proxy → `litellm`\n- Direct cloud API → `openai` / `azure` / `anthropic` / `gemini`"
          }
        }
      },
      {
        "title": "Models",
        "order": 2,
        "properties": {
          "OpenCob.model.chat": {
            "type": "string",
            "default": "azure/gpt-5-chat",
            "order": 1,
            "enum": [
              "azure/gpt-5-nano-EU",
              "azure/gpt-5",
              "azure/gpt-5-mini-EU",
              "azure/gpt-5-chat",
              "azure/gpt-5.1-EU",
              "azure/gpt-5.4",
              "azure/gpt-5.3-chat",
              "azure/gpt-5.4-nano",
              "azure/gpt-5.4-mini"
            ],
            "markdownDescription": "Model for **chat interactions** (agentic coding, Q&A, refactoring).\n\n[↻ Refresh Models](command:OpenCob.testConnection) _(re-fetches from provider)_"
          },
          "OpenCob.model.completion": {
            "type": "string",
            "default": "azure/gpt-5.4-nano",
            "order": 2,
            "enum": [
              "azure/gpt-5-nano-EU",
              "azure/gpt-5",
              "azure/gpt-5-mini-EU",
              "azure/gpt-5-chat",
              "azure/gpt-5.1-EU",
              "azure/gpt-5.4",
              "azure/gpt-5.3-chat",
              "azure/gpt-5.4-nano",
              "azure/gpt-5.4-mini"
            ],
            "markdownDescription": "Model for **inline code completion** (FIM / ghost text). Should be a fast, small model.\n\n[↻ Refresh Models](command:OpenCob.testConnection) _(re-fetches from provider)_"
          },
          "OpenCob.model.embedding": {
            "type": "string",
            "default": "azure/text-embedding-ada-002",
            "order": 3,
            "enum": [
              "azure/text-embedding-ada-002",
              "azure/text-embedding-3-large"
            ],
            "markdownDescription": "Model for **text embeddings** (workspace indexing & semantic search).\n\n[↻ Refresh Models](command:OpenCob.testConnection) _(re-fetches from provider)_"
          }
        }
      },
      {
        "title": "Ollama",
        "order": 3,
        "properties": {
          "OpenCob.ollama.baseUrl": {
            "type": "string",
            "default": "http://127.0.0.1:11434",
            "markdownDescription": "Ollama server URL. **Only used when provider is `ollama`.**\n\nStart Ollama with `ollama serve` before using."
          }
        }
      },
      {
        "title": "LiteLLM Proxy",
        "order": 4,
        "properties": {
          "OpenCob.litellm.baseUrl": {
            "type": "string",
            "default": "http://127.0.0.1:4000",
            "markdownDescription": "LiteLLM proxy URL. **Only used when provider is `litellm`.**\n\nLiteLLM acts as a unified proxy to route requests to any backend (Azure, AWS Bedrock, Vertex AI, etc.)."
          },
          "OpenCob.litellm.apiKey": {
            "type": "string",
            "default": "",
            "markdownDescription": "Bearer token for authenticating with the LiteLLM proxy. Stored in VS Code SecretStorage and migrated out of plain settings on activation."
          }
        }
      },
      {
        "title": "OpenAI",
        "order": 5,
        "properties": {
          "OpenCob.openai.baseUrl": {
            "type": "string",
            "default": "https://api.openai.com",
            "markdownDescription": "OpenAI API base URL. **Only used when provider is `openai`.**"
          },
          "OpenCob.openai.apiKey": {
            "type": "string",
            "default": "",
            "markdownDescription": "Your OpenAI API key. Stored in VS Code SecretStorage and migrated out of plain settings on activation."
          }
        }
      },
      {
        "title": "Azure OpenAI",
        "order": 6,
        "properties": {
          "OpenCob.azure.baseUrl": {
            "type": "string",
            "default": "",
            "markdownDescription": "Azure OpenAI endpoint. **Only used when provider is `azure`.**\n\nFormat: `https://{resource-name}.openai.azure.com`"
          },
          "OpenCob.azure.apiKey": {
            "type": "string",
            "default": "",
            "markdownDescription": "Azure OpenAI API key from your Azure Portal resource. Stored in VS Code SecretStorage and migrated out of plain settings on activation."
          }
        }
      },
      {
        "title": "Anthropic (Claude)",
        "order": 7,
        "properties": {
          "OpenCob.anthropic.baseUrl": {
            "type": "string",
            "default": "https://api.anthropic.com",
            "markdownDescription": "Anthropic API base URL. **Only used when provider is `anthropic`.**"
          },
          "OpenCob.anthropic.apiKey": {
            "type": "string",
            "default": "",
            "markdownDescription": "Your Anthropic API key. Stored in VS Code SecretStorage and migrated out of plain settings on activation."
          }
        }
      },
      {
        "title": "Google Gemini",
        "order": 8,
        "properties": {
          "OpenCob.gemini.baseUrl": {
            "type": "string",
            "default": "https://generativelanguage.googleapis.com/v1beta/openai",
            "markdownDescription": "Gemini OpenAI-compatible endpoint. **Only used when provider is `gemini`.**"
          },
          "OpenCob.gemini.apiKey": {
            "type": "string",
            "default": "",
            "markdownDescription": "Your Google AI API key. Stored in VS Code SecretStorage and migrated out of plain settings on activation."
          }
        }
      },
      {
        "title": "Custom OpenAI-Compatible",
        "order": 9,
        "properties": {
          "OpenCob.openaiCompatible.baseUrl": {
            "type": "string",
            "default": "http://127.0.0.1:8000",
            "markdownDescription": "Base URL for any OpenAI-compatible server (vLLM, text-generation-webui, LocalAI, etc.). **Only used when provider is `openai-compatible`.**"
          },
          "OpenCob.openaiCompatible.apiKey": {
            "type": "string",
            "default": "",
            "markdownDescription": "API key for your custom endpoint (leave empty if not required). Stored in VS Code SecretStorage and migrated out of plain settings on activation."
          }
        }
      },
      {
        "title": "Inline Completion",
        "order": 10,
        "properties": {
          "OpenCob.inlineCompletion.enabled": {
            "type": "boolean",
            "default": true,
            "order": 1,
            "markdownDescription": "Enable **inline code completion** (ghost text suggestions as you type)."
          },
          "OpenCob.inlineCompletion.debounceMs": {
            "type": "number",
            "default": 300,
            "minimum": 50,
            "maximum": 2000,
            "order": 2,
            "markdownDescription": "Delay (ms) after you stop typing before requesting a completion. Lower = faster but more API calls."
          },
          "OpenCob.inlineCompletion.maxPrefixChars": {
            "type": "number",
            "default": 8192,
            "minimum": 1024,
            "maximum": 32768,
            "order": 3,
            "markdownDescription": "Max characters of code **before** the cursor sent to the completion model (~4 chars ≈ 1 token)."
          },
          "OpenCob.inlineCompletion.maxSuffixChars": {
            "type": "number",
            "default": 4096,
            "minimum": 512,
            "maximum": 16384,
            "order": 4,
            "markdownDescription": "Max characters of code **after** the cursor sent to the completion model."
          },
          "OpenCob.inlineCompletion.maxCrossFileChars": {
            "type": "number",
            "default": 2048,
            "minimum": 0,
            "maximum": 8192,
            "order": 5,
            "markdownDescription": "Max characters from other open files included as cross-file context for better completions."
          }
        }
      },
      {
        "title": "Agent & Chat",
        "order": 11,
        "properties": {
          "OpenCob.contextWindow.maxTokens": {
            "type": "number",
            "default": 8192,
            "minimum": 1024,
            "maximum": 131072,
            "order": 1,
            "markdownDescription": "Max context window size (tokens) for chat interactions. Increase for larger codebases; decrease to save costs."
          },
          "OpenCob.autoApprove.read": {
            "type": "boolean",
            "default": true,
            "order": 2,
            "markdownDescription": "Auto-approve **read** tool calls (file reads, searches) without prompting."
          },
          "OpenCob.autoApprove.edit": {
            "type": "boolean",
            "default": false,
            "order": 3,
            "markdownDescription": "Auto-approve **file edit** tool calls without prompting. ⚠️ Use with caution."
          },
          "OpenCob.autoApprove.command": {
            "type": "boolean",
            "default": false,
            "order": 4,
            "markdownDescription": "Auto-approve **terminal command** execution without prompting. ⚠️ Use with caution."
          },
          "OpenCob.autoApprove.mcp": {
            "type": "boolean",
            "default": false,
            "order": 5,
            "markdownDescription": "Auto-approve **MCP tool** calls without prompting."
          },
          "OpenCob.promptEnhancement.enabled": {
            "type": "boolean",
            "default": false,
            "order": 6,
            "markdownDescription": "Enable **prompt enhancement** — uses a lightweight LLM call to refine vague prompts before the main agent inference."
          }
        }
      },
      {
        "title": "Enterprise",
        "order": 12,
        "properties": {
          "OpenCob.enterprise.serverUrl": {
            "type": "string",
            "default": "",
            "markdownDescription": "OpenCob Enterprise server URL for team features (telemetry, shared context, policy).\n\nExample: `https://opencob-ee.company.com`"
          }
        }
      }
    ]
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "watch": "pnpm build --watch",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src/",
    "clean": "rimraf dist",
    "package": "pnpm dlx @vscode/vsce package --no-dependencies"
  },
  "dependencies": {
    "@opencob/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "@types/vscode": "^1.100.0",
    "@vscode/test-electron": "^2.5.0",
    "esbuild": "^0.28.2",
    "rimraf": "^6.0.0",
    "vitest": "^3.2.0"
  }
}
