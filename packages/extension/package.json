{
  "name": "opencob",
  "displayName": "OpenCob",
  "description": "Open-Source AI Coding Assistant — Privacy-First, Legacy-Ready",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "publisher": "opencob",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/mountek/opencob"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Chat"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "OpenCob.openChat",
        "title": "OpenCob: Open Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "OpenCob.switchMode",
        "title": "OpenCob: Switch Mode"
      },
      {
        "command": "OpenCob.newConversation",
        "title": "OpenCob: New Conversation"
      },
      {
        "command": "OpenCob.toggleInlineCompletion",
        "title": "OpenCob: Toggle Inline Completion"
      },
      {
        "command": "OpenCob.selectModel",
        "title": "OpenCob: Select Model"
      },
      {
        "command": "OpenCob.undoLastTurn",
        "title": "OpenCob: Undo Last Turn"
      },
      {
        "command": "OpenCob.scanWorkspace",
        "title": "OpenCob: Scan Workspace for Issues"
      },
      {
        "command": "OpenCob.showFindings",
        "title": "OpenCob: Show Findings in Panel"
      },
      {
        "command": "OpenCob.toggleFindingsMode",
        "title": "OpenCob: Toggle Findings View Mode"
      },
      {
        "command": "OpenCob.clearFindings",
        "title": "OpenCob: Clear All Findings"
      },
      {
        "command": "OpenCob.connectEnterprise",
        "title": "OpenCob: Connect to Enterprise Server"
      },
      {
        "command": "OpenCob.disconnectEnterprise",
        "title": "OpenCob: Disconnect from Enterprise Server"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "opencob",
          "title": "OpenCob",
          "icon": "resources/icon-activitybar.svg"
        }
      ]
    },
    "views": {
      "opencob": [
        {
          "type": "webview",
          "id": "OpenCob.chatPanel",
          "name": "Chat"
        },
        {
          "type": "tree",
          "id": "OpenCob.findings",
          "name": "Findings"
        }
      ]
    },
    "configuration": {
      "title": "opencob",
      "properties": {
        "OpenCob.model.provider": {
          "type": "string",
          "default": "ollama",
          "enum": [
            "ollama",
            "litellm",
            "openai",
            "azure",
            "anthropic",
            "gemini",
            "openai-compatible"
          ],
          "enumDescriptions": [
            "Local Ollama server (default, privacy-first)",
            "LiteLLM proxy (OpenAI-compatible gateway to multiple providers)",
            "OpenAI API (GPT-4o, GPT-5, o1, etc.)",
            "Azure OpenAI Service",
            "Anthropic API (Claude Sonnet, Haiku, Opus)",
            "Google Gemini API (Gemini 2.5 Flash/Pro)",
            "Any custom OpenAI-compatible endpoint"
          ],
          "description": "LLM provider for inference"
        },
        "OpenCob.model.chat": {
          "type": "string",
          "default": "qwen2.5-coder:7b",
          "description": "Model for chat interactions (model name depends on selected provider)"
        },
        "OpenCob.model.completion": {
          "type": "string",
          "default": "qwen2.5-coder:1.5b",
          "description": "Model for inline code completion (model name depends on selected provider)"
        },
        "OpenCob.ollama.baseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:11434",
          "description": "Ollama API base URL"
        },
        "OpenCob.litellm.baseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:4000",
          "description": "LiteLLM proxy base URL"
        },
        "OpenCob.litellm.apiKey": {
          "type": "string",
          "default": "",
          "description": "API key for LiteLLM proxy"
        },
        "OpenCob.openai.baseUrl": {
          "type": "string",
          "default": "https://api.openai.com",
          "description": "OpenAI API base URL"
        },
        "OpenCob.openai.apiKey": {
          "type": "string",
          "default": "",
          "description": "OpenAI API key"
        },
        "OpenCob.azure.baseUrl": {
          "type": "string",
          "default": "",
          "description": "Azure OpenAI endpoint (e.g., https://your-resource.openai.azure.com)"
        },
        "OpenCob.azure.apiKey": {
          "type": "string",
          "default": "",
          "description": "Azure OpenAI API key"
        },
        "OpenCob.anthropic.baseUrl": {
          "type": "string",
          "default": "https://api.anthropic.com",
          "description": "Anthropic API base URL"
        },
        "OpenCob.anthropic.apiKey": {
          "type": "string",
          "default": "",
          "description": "Anthropic API key"
        },
        "OpenCob.gemini.baseUrl": {
          "type": "string",
          "default": "https://generativelanguage.googleapis.com/v1beta/openai",
          "description": "Google Gemini API base URL (OpenAI-compatible endpoint)"
        },
        "OpenCob.gemini.apiKey": {
          "type": "string",
          "default": "",
          "description": "Google Gemini API key"
        },
        "OpenCob.openaiCompatible.baseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8000",
          "description": "Custom OpenAI-compatible API base URL"
        },
        "OpenCob.openaiCompatible.apiKey": {
          "type": "string",
          "default": "",
          "description": "API key for custom OpenAI-compatible endpoint"
        },
        "OpenCob.autoApprove.read": {
          "type": "boolean",
          "default": false,
          "description": "Auto-approve read operations"
        },
        "OpenCob.autoApprove.edit": {
          "type": "boolean",
          "default": false,
          "description": "Auto-approve file edit operations"
        },
        "OpenCob.autoApprove.write": {
          "type": "boolean",
          "default": false,
          "description": "Deprecated alias for OpenCob.autoApprove.edit"
        },
        "OpenCob.autoApprove.command": {
          "type": "boolean",
          "default": false,
          "description": "Auto-approve terminal commands"
        },
        "OpenCob.model.embedding": {
          "type": "string",
          "default": "nomic-embed-text",
          "description": "Model for text embeddings (workspace indexing)"
        },
        "OpenCob.inlineCompletion.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable inline code completion (FIM ghost text)"
        },
        "OpenCob.inlineCompletion.debounceMs": {
          "type": "number",
          "default": 300,
          "minimum": 50,
          "maximum": 2000,
          "description": "Debounce delay in milliseconds before triggering completion"
        },
        "OpenCob.inlineCompletion.maxPrefixChars": {
          "type": "number",
          "default": 8192,
          "minimum": 1024,
          "maximum": 32768,
          "description": "Maximum prefix characters sent to the FIM model (~4 chars per token)"
        },
        "OpenCob.inlineCompletion.maxSuffixChars": {
          "type": "number",
          "default": 4096,
          "minimum": 512,
          "maximum": 16384,
          "description": "Maximum suffix characters sent to the FIM model"
        },
        "OpenCob.inlineCompletion.maxCrossFileChars": {
          "type": "number",
          "default": 2048,
          "minimum": 0,
          "maximum": 8192,
          "description": "Maximum characters from related open files for cross-file context"
        },
        "OpenCob.contextWindow.maxTokens": {
          "type": "number",
          "default": 8192,
          "minimum": 1024,
          "maximum": 131072,
          "description": "Maximum context window tokens for chat interactions"
        },
        "OpenCob.enterprise.serverUrl": {
          "type": "string",
          "default": "",
          "description": "OpenCob Enterprise server URL (e.g., https://opencob-ee.company.com)"
        },
        "OpenCob.enterprise.token": {
          "type": "string",
          "default": "",
          "description": "Authentication token for the Enterprise server"
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "watch": "pnpm build --watch",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src/",
    "clean": "rimraf dist",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "@opencob/core": "workspace:*"
  },
  "devDependencies": {
    "@types/vscode": "^1.100.0",
    "@vscode/test-electron": "^2.5.0",
    "esbuild": "^0.25.0",
    "rimraf": "^6.0.0",
    "vitest": "^3.2.0"
  }
}
