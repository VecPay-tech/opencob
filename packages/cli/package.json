{
  "name": "@opencob/cli",
  "version": "0.1.1",
  "license": "Apache-2.0",
  "description": "OpenCob Shell — terminal-based AI assistant",
  "type": "module",
  "bin": {
    "opencob": "./dist/index.js"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --outfile=dist/index.js --format=esm --platform=node --banner:js=\"#!/usr/bin/env node\"",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@opencob/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "esbuild": "^0.25.0",
    "rimraf": "^6.0.0",
    "vitest": "^3.2.0"
  }
}
