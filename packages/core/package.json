{
  "name": "@opencob/core",
  "version": "0.1.1",
  "license": "Apache-2.0",
  "description": "OpenCob core engine — modes, tools, agent orchestration, LLM adapters",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^3.2.4",
    "rimraf": "^6.0.0",
    "vitest": "^3.2.0"
  }
}
